{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CountdownTimer",
  "version": "0.1.0",
  "identifier": "io.github.whr819987540.countdowntimer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "倒计时",
        "width": 380,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "whr819987540",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "轻量的 Windows 倒计时工具",
    "longDescription": "设置时长后开始倒计时，结束时弹窗提醒，点击重置即可以相同时长再来一轮；支持托盘后台驻留与开机自启动。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
